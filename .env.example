# Copie para .env e preencha. O .env nunca vai para o Git.
# Os sinais <...> são marcadores, não valores.

# --- Servidor ---
PORT=4000
HOST=127.0.0.1
# Intervalo da sincronização automática (15 a 600 segundos). 120 s deixa folga para o alvo de 15 minutos.
SYNC_INTERVAL_SECONDS=120

# --- Google Drive ---
# local  = pasta ./demo-drive simulando o Drive (sem credenciais; para avaliação offline)
# google = pasta real do Drive via OAuth da sua conta
DRIVE_MODE=google
GOOGLE_CLIENT_ID=<SEU_CLIENT_ID_WEB>
GOOGLE_CLIENT_SECRET=<SEU_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
DRIVE_TEST_FOLDER_ID=<ID_DA_SUA_PASTA_DE_TESTE>
# Chave para criptografar os tokens OAuth guardados no servidor (32+ caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=<SEGREDO_ALEATORIO_DE_64_CARACTERES>

# --- IA (opcional) ---
# Sem chave, a extração usa regras determinísticas (mesmo contrato e mesma validação).
ANTHROPIC_API_KEY=<SUA_CHAVE_ANTHROPIC>
# auto (padrão): Claude se houver chave; claude: exige chave; heuristic: só regras.
AI_PROVIDER=auto
AI_MODEL=claude-opus-5-5

# --- Opcional ---
# Nome da planilha de registro, usado só se nenhum documento de índice a indicar.
# REGISTRY_FILE_NAME=Ata_registro.xlsx
