{
  "name": "central-lia",
  "version": "1.0.0",
  "private": true,
  "description": "Central de contexto, onboarding e atividades da Liga IA UFSCar — protótipo do case técnico",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "demo": "tsx scripts/demo-drive.ts reset && vite build && tsx src/server/index.ts --demo",
    "demo:start": "tsx src/server/index.ts --demo",
    "demo:drive": "tsx scripts/demo-drive.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@googleapis/drive": "^26.0.1",
    "@tanstack/react-query": "^5.104.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
